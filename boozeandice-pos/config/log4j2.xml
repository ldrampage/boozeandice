<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%p %thread %F:%L] %msg%n"/>
		</Console>
		<RollingFile name="RollingFile"
			fileName="C:\Projects\pos\boozeandice\boozeandice-pos\logs\dev.bicepos.log"
			filePattern="C:\Projects\pos\boozeandice\boozeandice-pos\logs\$${date:yyyy-MM}\dev.bicepos%d{-dd-MMMM-yyyy}-%i.log">
			<PatternLayout>
				<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%p %thread %F:%L] %msg%n</pattern>
			</PatternLayout>
			<Policies>
				<OnStartupTriggeringPolicy />
				<SizeBasedTriggeringPolicy size="20 MB"/>
				<TimeBasedTriggeringPolicy interval="1" />
			</Policies>
			<DefaultRolloverStrategy>
				<Delete basePath="${baseDir}" maxDepth="2">
					<IfFileName glob="C:\Projects\pos\boozeandice\boozeandice-pos\logs\$${date:yyyy-MM}\dev.bicepos.*.log" />
					<IfLastModified age="30d"/>
				</Delete>
			</DefaultRolloverStrategy>
		</RollingFile>
	</Appenders>
	<Loggers>
		<Root level="INFO">
			<AppenderRef ref="Console"/>
			<AppenderRef ref="RollingFile"/>
		</Root>
		<Logger name="com.boozeandice" level="DEBUG"></Logger>
	</Loggers>
</Configuration>